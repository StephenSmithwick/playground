# list commands
default:
    just --list

# Check formatting without rewriting files
fmt-check:
    cargo fmt --check

# Format the crate
fmt:
    cargo fmt

# Run clippy lint tests (complexity)
lint:
    cargo clippy --all-targets -- -D clippy::too_many_lines -D clippy::cognitive_complexity

# Check the crate after linting
check: lint
    cargo check

# Build the crate after linting
build: lint
    cargo build

# Run tests after linting
test: lint
    cargo test

# Run the full local verification suite
verify: fmt-check lint test

# Run the agent in the cli
run name="Partner": lint
    cargo run -- --name {name}
